# Copy to .env and fill in at least one provider key. The gateway picks the
# first configured provider in priority order (or set AUDIT_PROVIDER to pin one).
#
# AUDIT_PROVIDER = groq | gemini | together | anthropic   (optional)
# AUDIT_MODEL    = provider-specific model id             (optional)

GROQ_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=
